<section class="bh-page"><header class="bh-header bh-item-header"><img class="bh-item-image" src="{{item.img}}" alt="Imagem de {{item.name}}" data-edit="img" {{#if editable}}data-action="editImage" role="button" aria-label="Alterar imagem da munição"{{/if}}><div class="bh-identity"><label class="bh-name">Nome da munição<input name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}></label></div></header><div class="bh-body bh-compact-weapon"><fieldset class="bh-weapon-fields bh-ammunition-fields" {{#unless editable}}disabled{{/unless}}><label>Quantidade de balas<input type="number" name="system.quantity" min="0" step="1" value="{{system.quantity}}"></label><label>Calibre<input name="system.caliber" value="{{system.caliber}}"></label><label>Peso por bala (kg)<input type="number" name="system.weight" min="0" step="0.001" value="{{system.weight}}"></label><label class="bh-ammunition-notes">Observações<textarea name="system.notes" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label></fieldset></div></section>
