<section class="bh-page bh-audio-config"><label>Arquivo de áudio</label><div class="bh-audio-file"><input type="text" name="audio" value="{{src}}" aria-label="Arquivo de áudio" placeholder="Selecione um arquivo no Foundry" {{#unless editable}}disabled{{/unless}}><button type="button" data-action="browse" aria-label="Selecionar arquivo de áudio" {{#unless editable}}disabled{{/unless}}><i class="fas fa-folder-open" aria-hidden="true"></i></button></div><label>Volume<input type="range" name="volume" aria-label="Volume do disparo" min="0" max="100" step="1" value="{{volume}}" {{#unless editable}}disabled{{/unless}}></label><div class="bh-audio-actions"><button type="button" data-action="preview"><i class="fas fa-play" aria-hidden="true"></i> Ouvir</button><button type="button" data-action="clear" {{#unless editable}}disabled{{/unless}}>Remover som</button><button type="button" data-action="save" {{#unless editable}}disabled{{/unless}}>Salvar</button></div></section>