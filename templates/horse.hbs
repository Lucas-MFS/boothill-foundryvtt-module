<section class="bh-page bh-horse-page">
<header class="bh-header"><img class="bh-portrait" draggable="true" data-horse-drag src="{{actor.img}}" alt="{{localize 'BOOTHILL.Text.ef26df6b'}} {{actor.name}}" data-edit="img" role="button" tabindex="0" {{#if editable}}data-action="editImage" aria-label="{{localize 'BOOTHILL.Text.3b0b9203'}}" title="{{localize 'BOOTHILL.Text.3b0b9203'}}"{{else}}data-action="showPortraitArtwork" aria-label="{{localize 'BOOTHILL.Text.8515a03d'}}"{{/if}}><div class="bh-identity"><div class="bh-name-line"><label class="bh-name">{{localize 'BOOTHILL.Text.5e879d5f'}}<input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><span class="bh-wordmark">BOOT HILL<small>{{localize 'BOOTHILL.Text.2c764e47'}}</small></span></div></div></header>
<div class="bh-section-strip">{{localize 'BOOTHILL.Text.fc03d9bb'}} <span>Boot Hill</span></div>
<div class="bh-body bh-horse-grid">
<section class="bh-section bh-horse-attribute-panel" aria-label="{{localize 'BOOTHILL.Text.5859308d'}}"><h2>{{localize 'BOOTHILL.Text.a6746e1e'}}</h2><div class="bh-horse-attributes">{{#each attributes}}<div><button type="button" class="bh-roll-name" data-action="check" data-group="attributes" data-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-{{icon}}" aria-hidden="true"></i>{{label}}</button><input type="number" min="0" step="1" name="system.attributes.{{id}}" value="{{value}}" aria-label="{{localize 'BOOTHILL.Text.3663421a'}} {{label}}" {{#unless @root.editable}}disabled{{/unless}}></div>{{/each}}</div>
</section>
<section class="bh-section bh-horse-health" aria-label="{{localize 'BOOTHILL.Text.d2d7b2e5'}}"><h2>{{localize 'BOOTHILL.Text.d76a5d26'}} <span>{{localize 'BOOTHILL.Text.c02a0a94'}}</span></h2>
<div class="bh-horse-map"><img src="systems/boothill/assets/horse.png" alt="{{localize 'BOOTHILL.Text.4e5cb782'}}">{{#each locations}}<div class="bh-horse-location bh-horse-{{id}}"><span>{{label}}</span><div><label>{{localize 'BOOTHILL.Text.c90bfeab'}}<input type="number" min="0" step="1" name="system.health.locations.{{id}}.light" value="{{light}}" aria-label="{{localize 'BOOTHILL.Text.ac0e4242'}} {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label><label>{{localize 'BOOTHILL.Text.d60c1322'}}<input type="number" min="0" step="1" name="system.health.locations.{{id}}.serious" value="{{serious}}" aria-label="{{localize 'BOOTHILL.Text.5d9d7be4'}} {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label></div></div>{{/each}}</div>
<div class="bh-health-points"><label>{{localize 'BOOTHILL.Text.e7bd4282'}}<input type="number" name="system.health.points" value="{{actor.system.health.points}}" min="0" step="1" aria-label="{{localize 'BOOTHILL.Text.e7bd4282'}}" {{#unless editable}}disabled{{/unless}}></label><label>{{localize 'BOOTHILL.Text.7bf8a3bd'}}<input type="number" min="0" step="1" name="system.health.temporary" value="{{actor.system.health.temporary}}" {{#unless editable}}disabled{{/unless}}></label></div><div class="bh-health-total {{#if health.unconscious}}bh-danger{{/if}}"><strong>{{health.total}} / {{actor.system.attributes.strength}}</strong><span>{{localize 'BOOTHILL.Text.632604cd'}} {{#if health.unconscious}}· Desmaiado{{/if}}</span></div><button type="button" class="bh-mortal-toggle" data-action="toggleMortal" aria-pressed="{{actor.system.health.mortal}}" {{#unless editable}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.d0034519'}} <span>{{#if actor.system.health.mortal}}{{localize 'BOOTHILL.Text.3fbc5034'}}{{else}}{{localize 'BOOTHILL.Text.91e2889b'}}{{/if}}</span></button>
</section>
<section class="bh-section bh-inventory"><h2>{{localize 'BOOTHILL.Text.2ad0431a'}}</h2><table><thead><tr><th>{{localize 'BOOTHILL.Text.318c4cee'}}</th><th>Item</th><th><i class="fas fa-scale-balanced" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.39d23ea8'}}</th></tr></thead><tbody>{{#each gear}}<tr><td>{{#if weapon}}<img class="bh-weapon-thumb" src="{{img}}" alt="{{name}}">{{else}}<input type="number" min="0" step="1" value="{{quantity}}" data-inventory-id="{{id}}" data-field="quantity" data-document-item="{{documentItem}}" aria-label="{{localize 'BOOTHILL.Text.dc4225e'}} {{name}}">{{/if}}</td><td>{{#if documentItem}}<button type="button" class="bh-roll-name" data-action="openWeapon" data-id="{{id}}">{{name}}</button>{{else}}{{name}}{{/if}} <button type="button" class="bh-remove-gear" data-action="removeGear" data-id="{{id}}" data-weapon="{{weapon}}" data-document-item="{{documentItem}}" aria-label="{{localize 'BOOTHILL.Text.66a25ebd'}} {{name}}" title="{{localize 'BOOTHILL.Text.44229465'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-trash-can" aria-hidden="true"></i></button></td><td><input type="number" min="0" step="0.01" value="{{weight}}" data-inventory-id="{{id}}" data-field="weight" data-weapon="{{weapon}}" data-document-item="{{documentItem}}" aria-label="{{localize 'BOOTHILL.Text.6796883'}} {{name}} {{localize 'BOOTHILL.Text.38dd3267'}}"></td></tr>{{/each}}</tbody></table><p class="bh-load">{{localize 'BOOTHILL.Text.242b0309'}} <strong>{{totalWeight}} kg</strong> / <label>{{localize 'BOOTHILL.Text.970046ec'}}<input type="number" min="0" step="0.01" name="system.carryCapacity" value="{{actor.system.carryCapacity}}"></label></p><div class="bh-add-gear"><input type="number" min="1" step="1" value="1" data-gear-quantity aria-label="{{localize 'BOOTHILL.Text.1f93bfef'}}"><input data-gear-name placeholder="{{localize 'BOOTHILL.Text.a105460c'}}" aria-label="{{localize 'BOOTHILL.Text.a105460c'}}"><input type="number" min="0" step="0.01" value="0" data-gear-weight aria-label="{{localize 'BOOTHILL.Text.fa0ce6d0'}}"><button type="button" data-action="addGear" {{#unless editable}}disabled{{/unless}} aria-label="{{localize 'BOOTHILL.Text.194a37a8'}}" title="{{localize 'BOOTHILL.Text.194a37a8'}}"><i class="fas fa-plus" aria-hidden="true"></i></button></div></section>
<section class="bh-section bh-horse-skills" aria-label="{{localize 'BOOTHILL.Text.40029834'}}"><h2><span class="bh-work-title">{{localize 'BOOTHILL.Text.40029834'}} <button type="button" class="bh-skill-settings {{#if editingSkills}}active{{/if}}" data-action="toggleSkills" aria-label="{{#if editingSkills}}{{localize 'BOOTHILL.Text.5b26ece8'}}{{else}}{{localize 'BOOTHILL.Text.5d41c8c0'}}{{/if}}" aria-pressed="{{editingSkills}}" {{#unless editable}}disabled{{/unless}}><i class="fas fa-gear" aria-hidden="true"></i></button></span></h2>{{#unless hasHorseSkills}}{{#unless editingSkills}}<p class="bh-empty">{{localize 'BOOTHILL.Text.c830a852'}}</p>{{/unless}}{{/unless}}{{#each skills}}<div class="bh-horse-skill {{#if @root.editingSkills}}bh-horse-editing{{/if}}">{{#if @root.editingSkills}}<input type="checkbox" name="system.trained.{{id}}" aria-label="{{localize 'BOOTHILL.Text.dfeb3461'}} {{label}}" {{checked trained}} {{#unless @root.editable}}disabled{{/unless}}>{{/if}}<button type="button" class="bh-roll-name" data-action="check" data-group="skills" data-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-dice-d20" aria-hidden="true"></i>{{label}}</button><input type="number" name="system.skills.{{id}}" value="{{value}}" min="0" step="1" aria-label="{{localize 'BOOTHILL.Text.3663421a'}} {{label}}" {{#unless @root.editable}}disabled{{/unless}}></div>{{/each}}
<h3>{{localize 'BOOTHILL.Text.ccf60730'}}</h3>{{#each tricks}}<div class="bh-horse-skill bh-horse-trick {{#if @root.editingSkills}}bh-horse-editing{{/if}}"><button type="button" class="bh-roll-name" data-action="check" data-group="tricks" data-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-dice-d20" aria-hidden="true"></i><span>{{name}}</span></button><input type="number" value="{{level}}" min="0" step="1" data-trick-id="{{id}}" aria-label="{{localize 'BOOTHILL.Text.3663421a'}} {{name}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if @root.editingSkills}}<button type="button" class="bh-remove-gear" data-action="removeTrick" data-id="{{id}}" aria-label="{{localize 'BOOTHILL.Text.54a9eed9'}} {{name}}" {{#unless @root.editable}}disabled{{/unless}}>×</button>{{/if}}</div>{{/each}}{{#if editingSkills}}<div class="bh-add-trick"><input data-trick-name placeholder="{{localize 'BOOTHILL.Text.ad77495d'}}" aria-label="{{localize 'BOOTHILL.Text.ad77495d'}}" {{#unless editable}}disabled{{/unless}}><button type="button" data-action="addTrick" aria-label="{{localize 'BOOTHILL.Text.985a6d81'}}" {{#unless editable}}disabled{{/unless}}>+</button></div>{{/if}}
</section></div></section>