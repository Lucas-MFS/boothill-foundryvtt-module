<section class="bh-page">
  <header class="bh-header">
    <button class="bh-portrait" type="button" data-action="showPortraitArtwork" aria-label="Ver retrato"><img src="{{actor.img}}" alt="Retrato de {{actor.name}}"></button>
    <div class="bh-identity"><div class="bh-name-line"><label class="bh-name">Nome do personagem<input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><span class="bh-wordmark">BOOT HILL<small>3ª edição</small></span></div><div class="bh-personal">
      <label>Jogador<input name="system.identity.player" value="{{actor.system.identity.player}}" {{#unless editable}}disabled{{/unless}}></label><label class="bh-age">XP<input type="number" min="0" step="1" name="system.identity.xp" value="{{actor.system.identity.xp}}"></label><label class="bh-age">Idade<input type="number" min="0" step="1" name="system.identity.age" value="{{actor.system.identity.age}}" {{#unless editable}}disabled{{/unless}}></label><label class="bh-handed"><input type="checkbox" name="system.identity.ambidextrous" {{checked actor.system.identity.ambidextrous}} {{#unless editable}}disabled{{/unless}}> Ambidestro</label>
    </div></div>
  </header>
  <div class="bh-section-strip">Ficha de personagem <span>Boot Hill</span></div>
  <div class="bh-body bh-character-grid">
    <section class="bh-section bh-attributes" aria-label="Atributos"><h2>Atributos</h2><div class="bh-attribute-grid">
      {{#each attributes}}<div class="bh-attribute"><button type="button" class="bh-roll-name" data-action="check" data-group="attributes" data-id="{{id}}" title="Testar {{label}} · d20 · Shift+clique para ajustar" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-{{icon}}" aria-hidden="true"></i>{{label}}</button><input aria-label="Nível de {{label}}" name="system.attributes.{{id}}" type="number" min="0" step="1" value="{{value}}" {{#unless @root.editable}}disabled{{/unless}}></div>{{/each}}
    </div></section>
    <section class="bh-section bh-weapons" aria-label="Perícias de armas"><h2>Perícias de armas</h2>{{#each weapons}}<label class="bh-stat-row"><span class="bh-weapon-name">{{label}}</span><input aria-label="Nível de {{label}}" name="system.skills.{{id}}" type="number" min="0" step="1" value="{{value}}" {{#unless @root.editable}}disabled{{/unless}}></label>{{/each}}</section>
    <section class="bh-section bh-armament" aria-label="Armamento">
      <h2>Armamento <button type="button" class="bh-add-weapon" data-action="createWeapon" {{#unless editable}}disabled{{/unless}}><i class="fas fa-plus" aria-hidden="true"></i> Nova arma</button></h2>
      {{#if armament}}<table class="bh-armament-table"><thead><tr><th>Arma</th><th>Balas</th><th>Recarga</th><th>Empunhar</th></tr></thead><tbody>{{#each armament}}<tr class="draggable" draggable="true" data-item-id="{{id}}" data-action="toggleDetails" data-id="{{id}}" tabindex="0" aria-expanded="{{expanded}}"><td><button type="button" class="bh-roll-name bh-inventory-name" data-action="openWeapon" data-id="{{id}}"><img class="bh-weapon-thumb" src="{{img}}" alt="{{name}}"><span>{{name}}<small>{{category}} · {{handLabel}}{{#if offhandPenalty}} · Mão inábil −2{{/if}}</small></span></button></td><td class="bh-ammo"><input type="number" min="0" max="{{system.capacity}}" step="1" value="{{system.ammo}}" data-ammo-id="{{id}}" aria-label="Balas de {{name}}" {{#unless @root.editable}}disabled{{/unless}}> / {{system.capacity}}</td><td><button type="button" class="bh-reload" data-action="reloadWeapon" data-id="{{id}}" title="Recarregar um turno · {{remainingTurns}} turno(s) restantes" aria-label="Recarregar {{name}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-rotate" aria-hidden="true"></i> {{remainingTurns}}</button></td><td><button type="button" class="bh-equip-weapon" data-action="toggleWeapon" data-id="{{id}}" aria-label="Empunhar {{name}}" aria-pressed="{{#if system.equipped}}true{{else}}false{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if system.equipped}}<i class="fas fa-hand-fist" aria-hidden="true"></i> Sim{{else}}Não{{/if}}</button></td></tr><tr class="bh-weapon-details" {{#unless expanded}}hidden{{/unless}}><td colspan="4"><div class="bh-details-inner"><label>Alcance<select data-weapon-range>{{#each ranges}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if held}}{{#with held}}<button type="button" class="bh-rapidity" data-action="reportRapidity" data-id="{{id}}"><i class="fas fa-bolt" aria-hidden="true"></i> Rapidez <strong>{{rapidity}}</strong></button><div class="bh-shot-grid">{{#each shots}}<button type="button" data-action="shoot" data-id="{{../id}}" data-mode="{{mode}}" title="Um clique = uma bala · {{beats}} lance(s)" {{#unless available}}disabled{{/unless}} {{#unless @root.editable}}disabled{{/unless}}><span>{{label}}</span><strong>{{#if supported}}{{chance}}{{else}}—{{/if}}</strong></button>{{/each}}</div>{{/with}}{{else}}<p class="bh-note">Empunhe esta arma para atirar.</p>{{/if}}</div></td></tr>{{/each}}</tbody></table>{{else}}<p class="bh-empty">Arraste armas da aba Itens para o inventário.</p>{{/if}}
      {{#if held}}<div class="bh-shoot-controls">{{#if hasTwo}}<label class="bh-handed"><input type="checkbox" name="system.combat.dualFire" {{checked actor.system.combat.dualFire}} {{#unless editable}}disabled{{/unless}}> Usar duas armas (−6 em ambas)</label><button type="button" class="bh-add-weapon" data-action="swapHands" {{#unless editable}}disabled{{/unless}}>Trocar mãos</button>{{/if}}</div>{{/if}}

      {{#if held}}<p class="bh-note">Chance de acerto no d20 · Cada clique dispara uma bala. Shift+clique permite informar um modificador adicional.</p>{{/if}}
      <div class="bh-movement"><h3>Deslocamento</h3>{{#if movementActive}}<button type="button" class="bh-reload" data-action="clearMovement">Encerrar movimento / remover penalidade</button>{{/if}}<table><thead><tr><th>Movimento</th><th>Combate · 6 s</th><th>Tiroteio · 1 s</th></tr></thead><tbody>{{#each distances}}<tr><td><button type="button" class="bh-roll-name" data-action="move" data-id="{{id}}">{{label}}</button></td><td>{{combat}}</td><td>{{firefight}}</td></tr>{{/each}}</tbody></table><p class="bh-note">A pé: distâncias ajustadas pelos ferimentos. Montaria: valores de um animal sem ferimentos.</p></div>
    </section>
    <section class="bh-section bh-health" aria-label="Saúde"><h2>Saúde <span>Leves / Sérios</span></h2>
      <div class="bh-body-map"><img src="systems/boothill/assets/cowboy.png" alt="Silhueta de cowboy com regiões do corpo"><div class="bh-health-regions">{{#each locations}}<div class="bh-location bh-location-{{id}}"><span>{{label}}</span><div><label><span>L</span><input type="number" name="system.health.locations.{{id}}.light" aria-label="Ferimentos leves: {{label}}" value="{{light}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label><label><span>S</span><input type="number" name="system.health.locations.{{id}}.serious" aria-label="Ferimentos sérios: {{label}}" value="{{serious}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label></div></div>{{/each}}</div></div>
      <div class="bh-health-points"><label>Pontos de ferimento<input type="number" name="system.health.points" value="{{actor.system.health.points}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label><label>Pontos temporários<input type="number" name="system.health.temporary" value="{{actor.system.health.temporary}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label></div>
      <div class="bh-health-total {{#if health.unconscious}}bh-danger{{/if}}"><strong>{{health.total}} / {{actor.system.attributes.strength}}</strong><span>{{#if health.unconscious}}Desmaiado{{else}}Ferimentos / Força{{/if}}</span></div>
      <p class="bh-note">{{health.light}} leves · {{health.serious}} sérios · Precisão {{health.penalty}}. Pontos de dano são registrados separadamente da quantidade de feridas; temporários também contam para o desmaio.</p>
    </section>
    <section class="bh-section bh-work" aria-label="Perícias de trabalho"><h2><span class="bh-work-title">Perícias de trabalho <button type="button" class="bh-skill-settings {{#if editingSkills}}active{{/if}}" data-action="toggleSkills" aria-label="{{#if editingSkills}}Mostrar apenas perícias treinadas{{else}}Configurar perícias treinadas{{/if}}" aria-pressed="{{#if editingSkills}}true{{else}}false{{/if}}" {{#unless editable}}disabled{{/unless}}><i class="fas fa-gear" aria-hidden="true"></i></button></span></h2>
      {{#each work}}<div class="bh-skill-row {{#if @root.editingSkills}}bh-editing{{/if}} {{#if trained}}bh-trained{{/if}}">{{#if @root.editingSkills}}<input type="checkbox" name="system.trained.{{id}}" aria-label="Treinada em {{label}}" {{checked trained}}>{{/if}}<button type="button" class="bh-roll-name" data-action="check" data-group="skills" data-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}} title="Rolar {{label}} · Shift+clique para ajustar"><i class="fas fa-dice-d20" aria-hidden="true"></i><span>{{label}}</span></button><input aria-label="Nível de {{label}}" type="number" min="0" step="1" name="system.skills.{{id}}" value="{{value}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if @root.editingSkills}}<button type="button" class="bh-generate-skill" data-action="generateSkill" data-id="{{id}}" aria-label="Gerar nível de {{label}} com 2d10" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-dice" aria-hidden="true"></i></button>{{/if}}</div>{{/each}}
      {{#unless hasWork}}<p class="bh-empty">Use a engrenagem para selecionar as treinadas.</p>{{/unless}}
    </section>
    <section class="bh-section bh-inventory"><h2>Inventário</h2><table><thead><tr><th>Qtd.</th><th>Item</th><th>Peso</th></tr></thead><tbody>{{#each gear}}<tr><td>{{#if weapon}}<img class="bh-weapon-thumb" src="{{img}}" alt="{{name}}">{{else}}<input type="number" min="1" step="1" value="{{quantity}}" data-inventory-id="{{id}}" data-field="quantity" aria-label="Quantidade de {{name}}">{{/if}}</td><td>{{#if weapon}}<button type="button" class="bh-roll-name" data-action="openWeapon" data-id="{{id}}">{{name}}</button>{{else}}{{name}} <button type="button" class="bh-remove-gear" data-action="removeGear" data-id="{{id}}" aria-label="Remover {{name}}">×</button>{{/if}}</td><td><input type="number" min="0" step="0.01" value="{{weight}}" data-inventory-id="{{id}}" data-field="weight" data-weapon="{{weapon}}" aria-label="Peso de {{name}} em kg"></td></tr>{{/each}}</tbody></table><p class="bh-load">Carga <strong>{{totalWeight}} kg</strong> / <label>Limite (kg)<input type="number" min="0" step="0.01" name="system.carryCapacity" value="{{actor.system.carryCapacity}}"></label></p><div class="bh-add-gear"><input type="number" min="1" step="1" value="1" data-gear-quantity aria-label="Quantidade do item"><input data-gear-name placeholder="Nome do item" aria-label="Nome do item"><input type="number" min="0" step="0.01" value="0" data-gear-weight aria-label="Peso do item em kg"><button type="button" data-action="addGear">Adicionar</button></div></section>
    <details class="bh-creation"><summary>Criação do personagem <span>{{summary.used}}{{#if summary.budget}} / {{summary.budget}}{{/if}} escolhas</span></summary><div class="bh-creation-content"><button type="button" class="bh-generate" data-action="generate" {{#unless editable}}disabled{{/unless}}>Gerar os cinco atributos</button><p>Método 1 · 2d10 com modificadores. Soma dos atributos: {{summary.total}}.</p>{{#each summary.warnings}}<p class="bh-warning" role="status">{{this}}</p>{{/each}}</div></details>
  </div>
</section>
