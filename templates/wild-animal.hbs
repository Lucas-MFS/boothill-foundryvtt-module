<section class="bh-page bh-horse-page">
<header class="bh-header"><img class="bh-portrait" draggable="true" data-horse-drag src="{{actor.img}}" alt="{{localize 'BOOTHILL.Text.ef26df6b'}} {{actor.name}}" data-edit="img" role="button" tabindex="0" {{#if editable}}data-action="editImage" aria-label="{{localize 'BOOTHILL.Text.3b0b9203'}}" title="{{localize 'BOOTHILL.Text.3b0b9203'}}"{{else}}data-action="showPortraitArtwork" aria-label="{{localize 'BOOTHILL.Text.8515a03d'}}"{{/if}}><div class="bh-identity"><div class="bh-name-line"><label class="bh-name">{{localize 'BOOTHILL.Text.7470268f'}}<input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><span class="bh-wordmark">BOOT HILL<small>{{localize 'BOOTHILL.Text.2c764e47'}}</small></span></div></div></header>
<div class="bh-section-strip">{{localize 'BOOTHILL.Text.964c82f5'}} <span>Boot Hill</span></div>
<div class="bh-body bh-horse-grid">
<section class="bh-section bh-horse-attribute-panel" aria-label="{{localize 'BOOTHILL.Text.dd581fd5'}}"><h2 class="bh-animal-heading"><span>{{localize 'BOOTHILL.Text.a6746e1e'}}</span><button type="button" class="bh-animal-attack-button" data-action="attackAnimal" title="{{localize 'BOOTHILL.Text.19419b60'}}" {{#unless editable}}disabled{{/unless}}><i class="fas fa-paw" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.dffe6fab'}}</button></h2><div class="bh-horse-attributes"><div><label><i class="fas fa-hand-fist" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.34ab487c'}}<input type="number" min="0" step="1" name="system.attributes.strength" value="{{actor.system.attributes.strength}}" {{#unless editable}}disabled{{/unless}}></label></div><div><label><i class="fas fa-paw" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.677a486c'}}<input type="number" step="1" name="system.animal.attack" value="{{animal.attack}}" {{#unless editable}}disabled{{/unless}}></label></div><div><label><i class="fas fa-burst" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.edd6ee11'}}<input type="number" step="1" name="system.animal.severity" value="{{animal.severity}}" {{#unless editable}}disabled{{/unless}}></label></div><div><label><i class="fas fa-shield-halved" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.278ca5d0'}}<input type="number" step="1" name="system.animal.defense" value="{{animal.defense}}" {{#unless editable}}disabled{{/unless}}></label></div></div>
</section>
<section class="bh-section bh-horse-health" aria-label="{{localize 'BOOTHILL.Text.d34fa00d'}}"><h2>{{localize 'BOOTHILL.Text.d76a5d26'}} <span>{{localize 'BOOTHILL.Text.c02a0a94'}}</span></h2>
<div class="bh-horse-map bh-wild-map"><img src="systems/boothill/assets/bear.png" alt="{{localize 'BOOTHILL.Text.5874e5b'}}">{{#each locations}}<div class="bh-horse-location bh-horse-{{id}}"><span>{{label}}</span><div><label>{{localize 'BOOTHILL.Text.c90bfeab'}}<input type="number" min="0" step="1" name="system.health.locations.{{id}}.light" value="{{light}}" aria-label="{{localize 'BOOTHILL.Text.ac0e4242'}} {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label><label>{{localize 'BOOTHILL.Text.d60c1322'}}<input type="number" min="0" step="1" name="system.health.locations.{{id}}.serious" value="{{serious}}" aria-label="{{localize 'BOOTHILL.Text.5d9d7be4'}} {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label></div></div>{{/each}}</div>
<div class="bh-health-points"><label>{{localize 'BOOTHILL.Text.e7bd4282'}}<input type="number" name="system.health.points" value="{{actor.system.health.points}}" min="0" step="1" aria-label="{{localize 'BOOTHILL.Text.e7bd4282'}}" {{#unless editable}}disabled{{/unless}}></label><label>{{localize 'BOOTHILL.Text.7bf8a3bd'}}<input type="number" min="0" step="1" name="system.health.temporary" value="{{actor.system.health.temporary}}" {{#unless editable}}disabled{{/unless}}></label></div><div class="bh-health-total {{#if health.unconscious}}bh-danger{{/if}}"><strong>{{health.total}} / {{actor.system.attributes.strength}}</strong><span>{{localize 'BOOTHILL.Text.632604cd'}} {{#if health.unconscious}}· Desmaiado{{/if}}</span></div><button type="button" class="bh-mortal-toggle" data-action="toggleMortal" aria-pressed="{{actor.system.health.mortal}}" {{#unless editable}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.d0034519'}} <span>{{#if actor.system.health.mortal}}{{localize 'BOOTHILL.Text.3fbc5034'}}{{else}}{{localize 'BOOTHILL.Text.91e2889b'}}{{/if}}</span></button>
</section>
</div></section>
