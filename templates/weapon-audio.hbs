<section class="bh-page bh-audio-config"><h2>Disparo</h2><label>Arquivo de áudio</label><div class="bh-audio-file"><input type="text" name="audio" value="{{src}}" aria-label="Arquivo de áudio" placeholder="Selecione um arquivo no Foundry" {{#unless editable}}disabled{{/unless}}><button type="button" data-action="browse" aria-label="Selecionar arquivo de áudio" {{#unless editable}}disabled{{/unless}}><i class="fas fa-folder-open" aria-hidden="true"></i></button></div><label>Volume<input type="range" name="volume" aria-label="Volume do disparo" min="0" max="100" step="1" value="{{volume}}" {{#unless editable}}disabled{{/unless}}></label><div class="bh-audio-actions"><button type="button" data-action="preview"><i class="fas fa-play" aria-hidden="true"></i> Ouvir</button><button type="button" data-action="clear" {{#unless editable}}disabled{{/unless}}>Remover som</button></div><h2>Recarga</h2><label>Arquivo de recarga</label><div class="bh-audio-file"><input type="text" name="reloadAudio" value="{{reloadSrc}}" aria-label="Arquivo de recarga" placeholder="Selecione o áudio de recarga" {{#unless editable}}disabled{{/unless}}><button type="button" data-action="browse" data-kind="reload" aria-label="Selecionar áudio de recarga" {{#unless editable}}disabled{{/unless}}><i class="fas fa-folder-open" aria-hidden="true"></i></button></div><label>Volume da recarga<input type="range" name="reloadVolume" aria-label="Volume da recarga" min="0" max="100" step="1" value="{{reloadVolume}}" {{#unless editable}}disabled{{/unless}}></label><div class="bh-audio-actions"><button type="button" data-action="preview" data-kind="reload"><i class="fas fa-play" aria-hidden="true"></i> Ouvir</button><button type="button" data-action="clear" data-kind="reload" {{#unless editable}}disabled{{/unless}}>Remover som</button></div><button type="button" data-action="save" {{#unless editable}}disabled{{/unless}}>Salvar</button></section>