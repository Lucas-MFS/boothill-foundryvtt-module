<section class="bh-page {{#if isNpc}}bh-npc-page{{/if}}">
  <header class="bh-header">
    <img class="bh-portrait" src="{{actor.img}}" alt="{{localize 'BOOTHILL.Text.ef26df6b'}} {{actor.name}}" data-edit="img" role="button" tabindex="0" {{#if editable}}data-action="editImage" aria-label="{{localize 'BOOTHILL.Text.3b0b9203'}}" title="{{localize 'BOOTHILL.Text.3b0b9203'}}"{{else}}data-action="showPortraitArtwork" aria-label="{{localize 'BOOTHILL.Text.8515a03d'}}"{{/if}}>
    <div class="bh-identity"><div class="bh-name-line"><label class="bh-name">{{#if isNpc}}{{localize 'BOOTHILL.Text.aca23cba'}}{{else}}{{localize 'BOOTHILL.Text.e9421b5c'}}{{/if}}<input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><span class="bh-wordmark">BOOT HILL<small>{{localize 'BOOTHILL.Text.2c764e47'}}</small></span></div><div class="bh-personal">
      {{#unless isNpc}}<label>{{localize 'BOOTHILL.Text.89a201fb'}}<input name="system.identity.player" value="{{actor.system.identity.player}}" {{#unless editable}}disabled{{/unless}}></label><label class="bh-age">XP<input type="number" min="0" step="1" name="system.identity.xp" value="{{actor.system.identity.xp}}"></label><label class="bh-age">{{localize 'BOOTHILL.Text.ce4bba30'}}<input type="number" min="0" step="1" name="system.identity.age" value="{{actor.system.identity.age}}" {{#unless editable}}disabled{{/unless}}></label>{{/unless}}<label class="bh-handed"><input type="checkbox" name="system.identity.ambidextrous" {{checked actor.system.identity.ambidextrous}} {{#unless editable}}disabled{{/unless}}> {{localize 'BOOTHILL.Text.e4e1aa39'}}</label>
    <div class="bh-mount-slot" aria-label="{{localize 'BOOTHILL.Text.90b32896'}}">{{#if mount}}<div class="bh-mount-link" data-mount-link role="button" tabindex="0" aria-label="{{localize 'BOOTHILL.Text.7c84a1ba'}} {{mount.name}}" title="{{localize 'BOOTHILL.Text.9fd2a0e5'}}"><img src="{{mount.img}}" alt="{{mount.name}}"><span>{{mount.name}}<small>{{mount.tokenName}}</small></span></div><button type="button" class="bh-mount-state" data-action="toggleMount" aria-pressed="{{mount.mounted}}" {{#unless editable}}disabled{{/unless}}>{{#if mount.mounted}}{{localize 'BOOTHILL.Text.28fdc3f'}}{{else}}{{localize 'BOOTHILL.Text.b08b98c5'}}{{/if}}</button><button type="button" class="bh-mount-token" data-action="chooseMountToken" title="{{localize 'BOOTHILL.Text.abd3cdf7'}}" aria-label="{{localize 'BOOTHILL.Text.a88fb697'}}" {{#unless editable}}disabled{{/unless}}><i class="fas fa-crosshairs" aria-hidden="true"></i></button><button type="button" class="bh-remove-gear" data-action="removeMount" aria-label="{{localize 'BOOTHILL.Text.30362fb2'}}" {{#unless editable}}disabled{{/unless}}>×</button>{{else}}<span class="bh-mount-placeholder"><i class="fas fa-horse" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.d9d34923'}}</span><button type="button" class="bh-mount-state" data-action="chooseMount" {{#unless editable}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.b5f26257'}}</button>{{/if}}</div></div></div>
  </header>
  <div class="bh-section-strip">{{#if isNpc}}{{localize 'BOOTHILL.Text.56eae80e'}}{{else}}{{localize 'BOOTHILL.Text.245f3c30'}}{{/if}} <span>Boot Hill</span></div>
  <div class="bh-body bh-character-grid">
    <div class="bh-sheet-column bh-main-column">
    <section class="bh-section bh-attributes" aria-label="{{localize 'BOOTHILL.Text.a6746e1e'}}"><h2>{{localize 'BOOTHILL.Text.a6746e1e'}}</h2><div class="bh-attribute-grid">
      {{#each attributes}}<div class="bh-attribute"><button type="button" class="bh-roll-name" data-action="check" data-group="attributes" data-id="{{id}}" title="{{localize 'BOOTHILL.Text.282d443a'}} {{label}} {{localize 'BOOTHILL.Text.9461fe0b'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-{{icon}}" aria-hidden="true"></i>{{label}}</button><input aria-label="{{localize 'BOOTHILL.Text.3663421a'}} {{label}}" name="system.attributes.{{id}}" type="number" min="0" step="1" value="{{value}}" {{#unless @root.editable}}disabled{{/unless}}></div>{{/each}}
    </div>{{#if extraAttributes}}<div class="bh-npc-traits">{{#each extraAttributes}}<div class="bh-npc-trait"><button type="button" class="bh-roll-name" data-action="check" data-group="attributes" data-id="{{id}}" title="{{localize 'BOOTHILL.Text.b11d4a20'}}">{{label}}</button><input type="number" min="0" step="1" name="system.attributes.{{id}}" value="{{value}}" aria-label="{{localize 'BOOTHILL.Text.3663421a'}} {{label}}" {{#unless @root.editable}}disabled{{/unless}}></div>{{/each}}<small>{{localize 'BOOTHILL.Text.5a3b4f2c'}}</small></div>{{/if}}</section>
    <section class="bh-section bh-armament" aria-label="{{localize 'BOOTHILL.Text.1652bf9d'}}">
      <h2>{{localize 'BOOTHILL.Text.1652bf9d'}} <button type="button" class="bh-add-weapon" data-action="createWeapon" {{#unless editable}}disabled{{/unless}}><i class="fas fa-plus" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.6b291114'}}</button></h2>
      {{#if armament}}<table class="bh-armament-table"><thead><tr><th>{{localize 'BOOTHILL.Text.2da267dc'}}</th><th>{{localize 'BOOTHILL.Text.a095a8c0'}}</th><th>{{localize 'BOOTHILL.Text.36e5e4ae'}}</th><th>{{localize 'BOOTHILL.Text.e256a4e5'}}</th></tr></thead><tbody>{{#each armament}}<tr class="draggable" draggable="true" data-item-id="{{id}}" data-action="toggleDetails" data-id="{{id}}" tabindex="0" aria-expanded="{{expanded}}"><td><button type="button" class="bh-roll-name bh-inventory-name" data-action="openWeapon" data-id="{{id}}"><img class="bh-weapon-thumb" src="{{img}}" alt="{{name}}"><span>{{name}}<small>{{category}} · {{handLabel}}{{#if system.malfunction}} {{localize 'BOOTHILL.Text.9b0980d2'}}{{/if}}{{#if offhandPenalty}} {{localize 'BOOTHILL.Text.2df9f184'}}{{/if}}</small></span></button><button type="button" class="bh-remove-gear" data-action="removeGear" data-id="{{id}}" data-weapon="true" aria-label="{{localize 'BOOTHILL.Text.66a25ebd'}} {{name}}" title="{{localize 'BOOTHILL.Text.44229465'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-trash-can" aria-hidden="true"></i></button></td><td class="bh-ammo"><input type="number" min="0" max="{{system.capacity}}" step="1" value="{{system.ammo}}" data-ammo-id="{{id}}" aria-label="{{localize 'BOOTHILL.Text.5f86e2cb'}} {{name}}" {{#unless @root.editable}}disabled{{/unless}}> / {{system.capacity}}</td><td><button type="button" class="bh-reload" data-action="reloadWeapon" data-id="{{id}}" title="{{localize 'BOOTHILL.Text.5724b2a6'}} {{remainingTurns}} {{localize 'BOOTHILL.Text.b702f28e'}}" aria-label="{{localize 'BOOTHILL.Text.e625144f'}} {{name}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-rotate" aria-hidden="true"></i> {{remainingTurns}}</button></td><td><button type="button" class="bh-equip-weapon" data-action="toggleWeapon" data-id="{{id}}" aria-label="{{localize 'BOOTHILL.Text.e256a4e5'}} {{name}}" aria-pressed="{{#if system.equipped}}true{{else}}false{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if system.equipped}}<i class="fas fa-hand-fist" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.3fbc5034'}}{{else}}{{localize 'BOOTHILL.Text.91e2889b'}}{{/if}}</button></td></tr><tr class="bh-weapon-details" {{#unless expanded}}hidden{{/unless}}><td colspan="4"><div class="bh-details-inner"><label>{{localize 'BOOTHILL.Text.7eee82f2'}}<select data-weapon-range>{{#each ranges}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>{{localize 'BOOTHILL.Text.7415acfd'}}<select data-weapon-ammunition="{{id}}" aria-label="{{localize 'BOOTHILL.Text.48ce91d4'}} {{name}}" {{#unless @root.editable}}disabled{{/unless}}><option value="">{{localize 'BOOTHILL.Text.3d43526e'}}</option>{{#each ammunition}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if held}}{{#with held}}<button type="button" class="bh-rapidity" data-action="reportRapidity" data-id="{{id}}"><i class="fas fa-bolt" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.fc5a17fa'}} <strong>{{rapidity}}</strong></button><div class="bh-shot-grid">{{#each shots}}<button type="button" data-action="shoot" data-id="{{../id}}" data-mode="{{mode}}" title="{{localize 'BOOTHILL.Text.f2715ab7'}} {{beats}} {{localize 'BOOTHILL.Text.da2f29f4'}}" {{#unless available}}disabled{{/unless}} {{#unless @root.editable}}disabled{{/unless}}><span>{{label}}</span><strong>{{#if supported}}{{chance}}{{else}}—{{/if}}</strong></button>{{/each}}</div>{{/with}}{{else}}<p class="bh-note">{{localize 'BOOTHILL.Text.c2e21f7c'}}</p>{{/if}}</div></td></tr>{{/each}}</tbody></table>{{else}}<p class="bh-empty">{{localize 'BOOTHILL.Text.5ca6b2db'}}</p>{{/if}}
      {{#if held}}<div class="bh-shoot-controls">{{#if hasTwo}}<label class="bh-handed"><input type="checkbox" name="system.combat.dualFire" {{checked actor.system.combat.dualFire}} {{#unless editable}}disabled{{/unless}}> {{localize 'BOOTHILL.Text.ad3ff902'}}</label><button type="button" class="bh-add-weapon" data-action="swapHands" {{#unless editable}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.430c1620'}}</button>{{/if}}</div>{{/if}}

      {{#if held}}<p class="bh-note">{{localize 'BOOTHILL.Text.9f0fe30'}}</p>{{/if}}
      <div class="bh-movement"><div class="bh-movement-heading"><h3>{{localize 'BOOTHILL.Text.ec2092af'}}</h3><div class="bh-movement-tabs" role="tablist" aria-label="{{localize 'BOOTHILL.Text.7036c2c8'}}"><button type="button" role="tab" data-action="movementTab" data-id="foot" aria-selected="{{#unless mountedTab}}true{{else}}false{{/unless}}">{{localize 'BOOTHILL.Text.fe6e2122'}}</button><button type="button" role="tab" data-action="movementTab" data-id="mounted" aria-selected="{{#if mountedTab}}true{{else}}false{{/if}}">{{localize 'BOOTHILL.Text.28fdc3f'}}</button></div></div>{{#if movementActive}}<button type="button" class="bh-reload" data-action="clearMovement">{{localize 'BOOTHILL.Text.b87180f5'}}</button>{{/if}}<table><thead><tr><th>{{localize 'BOOTHILL.Text.8a77d651'}}</th><th>{{localize 'BOOTHILL.Text.c28c5142'}}</th><th>{{localize 'BOOTHILL.Text.26e82d95'}}</th></tr></thead><tbody>{{#each distances}}<tr data-movement-group="{{group}}" {{#unless visible}}hidden{{/unless}}><td><button type="button" class="bh-roll-name" data-action="move" data-id="{{id}}">{{label}}</button></td><td>{{combat}}</td><td>{{firefight}}</td></tr>{{/each}}</tbody></table></div>
    </section>
    {{#unless isNpc}}<section class="bh-section bh-inventory"><h2>{{localize 'BOOTHILL.Text.2ad0431a'}}</h2><table><thead><tr><th>{{localize 'BOOTHILL.Text.318c4cee'}}</th><th>Item</th><th><i class="fas fa-scale-balanced" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.39d23ea8'}}</th></tr></thead><tbody>{{#each gear}}<tr><td>{{#if weapon}}<img class="bh-weapon-thumb" src="{{img}}" alt="{{name}}">{{else}}<input type="number" min="0" step="1" value="{{quantity}}" data-inventory-id="{{id}}" data-field="quantity" data-document-item="{{documentItem}}" aria-label="{{localize 'BOOTHILL.Text.dc4225e'}} {{name}}">{{/if}}</td><td>{{#if documentItem}}<button type="button" class="bh-roll-name" data-action="openWeapon" data-id="{{id}}">{{name}}</button>{{else}}{{name}}{{/if}} <button type="button" class="bh-remove-gear" data-action="removeGear" data-id="{{id}}" data-weapon="{{weapon}}" data-document-item="{{documentItem}}" aria-label="{{localize 'BOOTHILL.Text.66a25ebd'}} {{name}}" title="{{localize 'BOOTHILL.Text.44229465'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-trash-can" aria-hidden="true"></i></button></td><td><input type="number" min="0" step="0.01" value="{{weight}}" data-inventory-id="{{id}}" data-field="weight" data-weapon="{{weapon}}" data-document-item="{{documentItem}}" aria-label="{{localize 'BOOTHILL.Text.6796883'}} {{name}} {{localize 'BOOTHILL.Text.38dd3267'}}"></td></tr>{{/each}}</tbody></table><p class="bh-load">{{localize 'BOOTHILL.Text.242b0309'}} <strong>{{totalWeight}} kg</strong> / <label>{{localize 'BOOTHILL.Text.970046ec'}}<input type="number" min="0" step="0.01" name="system.carryCapacity" value="{{actor.system.carryCapacity}}"></label></p><div class="bh-add-gear"><input type="number" min="1" step="1" value="1" data-gear-quantity aria-label="{{localize 'BOOTHILL.Text.1f93bfef'}}"><input data-gear-name placeholder="{{localize 'BOOTHILL.Text.a105460c'}}" aria-label="{{localize 'BOOTHILL.Text.a105460c'}}"><input type="number" min="0" step="0.01" value="0" data-gear-weight aria-label="{{localize 'BOOTHILL.Text.fa0ce6d0'}}"><button type="button" data-action="addGear" aria-label="{{localize 'BOOTHILL.Text.194a37a8'}}" title="{{localize 'BOOTHILL.Text.194a37a8'}}"><i class="fas fa-plus" aria-hidden="true"></i></button></div></section>
    {{/unless}}{{#if isNpc}}<details class="bh-creation"><summary>{{localize 'BOOTHILL.Text.4bba1491'}}</summary><div class="bh-creation-content"><button type="button" class="bh-generate" data-action="generate" {{#unless editable}}disabled{{/unless}} {{#unless canGenerate}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.e4a341b7'}}</button><p>{{localize 'BOOTHILL.Text.4e5eeac9'}}</p></div></details>{{else}}<details class="bh-creation"><summary>{{localize 'BOOTHILL.Text.b5055c5d'}} <span>{{summary.used}}{{#if summary.budget}} / {{summary.budget}}{{/if}} {{localize 'BOOTHILL.Text.7a9e2b5b'}}</span></summary><div class="bh-creation-content"><button type="button" class="bh-generate" data-action="generate" {{#unless editable}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.8638e24d'}}</button><p>{{localize 'BOOTHILL.Text.816a2357'}} {{summary.total}}.</p>{{#each summary.warnings}}<p class="bh-warning" role="status">{{this}}</p>{{/each}}</div></details>{{/if}}
    </div>
    <div class="bh-sheet-column bh-side-column">
    <section class="bh-section bh-health" aria-label="{{localize 'BOOTHILL.Text.d76a5d26'}}"><h2>{{localize 'BOOTHILL.Text.d76a5d26'}} <span>{{localize 'BOOTHILL.Text.c02a0a94'}}</span></h2>
      <div class="bh-body-map"><img src="systems/boothill/assets/cowboy.png" alt="{{localize 'BOOTHILL.Text.d54c44b5'}}"><div class="bh-health-regions">{{#each locations}}<div class="bh-location bh-location-{{id}}"><span>{{label}}</span><div><label><span>{{localize 'BOOTHILL.Text.c90bfeab'}}</span><input type="number" name="system.health.locations.{{id}}.light" aria-label="{{localize 'BOOTHILL.Text.ac0e4242'}} {{label}}" value="{{light}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label><label><span>{{localize 'BOOTHILL.Text.d60c1322'}}</span><input type="number" name="system.health.locations.{{id}}.serious" aria-label="{{localize 'BOOTHILL.Text.5d9d7be4'}} {{label}}" value="{{serious}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label></div></div>{{/each}}</div></div>
      <div class="bh-health-points"><label>{{localize 'BOOTHILL.Text.e7bd4282'}}<input type="number" name="system.health.points" value="{{actor.system.health.points}}" min="0" step="1" aria-label="{{localize 'BOOTHILL.Text.e7bd4282'}}" {{#unless editable}}disabled{{/unless}}></label><label>{{localize 'BOOTHILL.Text.7bf8a3bd'}}<input type="number" name="system.health.temporary" value="{{actor.system.health.temporary}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></label></div>
      <div class="bh-health-total {{#if health.unconscious}}bh-danger{{/if}}"><strong>{{health.total}} / {{actor.system.attributes.strength}}</strong><span>{{#if actor.system.health.mortal}}{{localize 'BOOTHILL.Text.d0034519'}}{{else}}{{#if health.unconscious}}{{localize 'BOOTHILL.Text.e19f53d6'}}{{else}}{{localize 'BOOTHILL.Text.632604cd'}}{{/if}}{{/if}}</span></div>
      <button type="button" class="bh-mortal-toggle" data-action="toggleMortal" aria-pressed="{{#if actor.system.health.mortal}}true{{else}}false{{/if}}" title="{{localize 'BOOTHILL.Text.1ee03276'}}" {{#unless editable}}disabled{{/unless}}><i class="fas fa-circle" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.d0034519'}} <span>{{#if actor.system.health.mortal}}{{localize 'BOOTHILL.Text.3fbc5034'}}{{else}}{{localize 'BOOTHILL.Text.91e2889b'}}{{/if}}</span></button>

    </section>
    <section class="bh-section bh-weapons" aria-label="{{localize 'BOOTHILL.Text.90dd4dd0'}}"><h2>{{localize 'BOOTHILL.Text.90dd4dd0'}}</h2>
      {{#each weapons}}<div class="bh-weapon-skill">
        <div class="bh-stat-row">{{#if expandable}}<button type="button" class="bh-skill-toggle" data-action="toggleSkillDetails" data-id="{{id}}" aria-expanded="{{expanded}}" title="{{localize 'BOOTHILL.Text.6cd813e9'}} {{label}}"><span>{{label}}</span><i class="fas fa-chevron-down" aria-hidden="true"></i></button>{{else}}<span class="bh-weapon-name">{{label}}</span>{{/if}}<input aria-label="{{localize 'BOOTHILL.Text.3663421a'}} {{label}}" name="system.skills.{{id}}" type="number" min="0" step="1" value="{{value}}" {{#unless @root.editable}}disabled{{/unless}}></div>
        {{#if expandable}}<div class="bh-melee-details" {{#unless expanded}}hidden{{/unless}}>
          {{#if brawl}}<div class="bh-melee-buttons"><button type="button" data-action="melee" data-mode="brawl" title="{{localize 'BOOTHILL.Text.b6f1c699'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-hand-fist" aria-hidden="true"></i> {{localize 'BOOTHILL.Text.bcc90798'}}</button><button type="button" data-action="melee" data-mode="grapple" title="{{localize 'BOOTHILL.Text.96a7a3fe'}}" {{#unless @root.editable}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.c951006e'}}</button></div>
          <div class="bh-melee-options"><label class="bh-handed"><input type="checkbox" name="system.combat.stronger" {{checked @root.actor.system.combat.stronger}} {{#unless @root.editable}}disabled{{/unless}}> {{localize 'BOOTHILL.Text.acf2d7bd'}}</label></div>
          {{#if @root.outgoingHold}}<div class="bh-melee-buttons"><button type="button" data-action="melee" data-mode="maintain">{{localize 'BOOTHILL.Text.e9570149'}}</button><button type="button" data-action="melee" data-mode="release">{{localize 'BOOTHILL.Text.2c872447'}}</button></div>{{/if}}{{/if}}
          {{#if blade}}<div class="bh-melee-buttons"><button type="button" data-action="melee" data-mode="knife" title="{{localize 'BOOTHILL.Text.c491059d'}}" {{#unless @root.editable}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.2f955d0b'}}</button></div><div class="bh-melee-options"><label class="bh-handed"><input type="checkbox" name="system.combat.bladeReady" {{checked @root.actor.system.combat.bladeReady}} {{#unless @root.editable}}disabled{{/unless}}> {{localize 'BOOTHILL.Text.699239d1'}}</label></div>{{/if}}
          <button type="button" class="bh-clear-melee" data-action="clearMelee" title="{{localize 'BOOTHILL.Text.74224e4b'}}" {{#unless @root.editable}}disabled{{/unless}}>{{localize 'BOOTHILL.Text.d9a0223'}}</button>
        </div>{{/if}}
      </div>{{/each}}
      {{#if meleeEffect}}<p class="bh-note">{{localize 'BOOTHILL.Text.7703c644'}} {{meleeEffect}} {{localize 'BOOTHILL.Text.b26216ef'}}</p>{{/if}}{{#if meleeHolds}}<p class="bh-note">{{meleeHolds}}</p>{{/if}}
    </section>
    <section class="bh-section bh-work" aria-label="{{localize 'BOOTHILL.Text.c23c1e4b'}}"><h2><span class="bh-work-title">{{localize 'BOOTHILL.Text.c23c1e4b'}} <button type="button" class="bh-skill-settings {{#if editingSkills}}active{{/if}}" data-action="toggleSkills" aria-label="{{#if editingSkills}}{{localize 'BOOTHILL.Text.5b26ece8'}}{{else}}{{localize 'BOOTHILL.Text.5d41c8c0'}}{{/if}}" aria-pressed="{{#if editingSkills}}true{{else}}false{{/if}}" {{#unless editable}}disabled{{/unless}}><i class="fas fa-gear" aria-hidden="true"></i></button></span></h2>
      {{#each work}}<div class="bh-skill-row {{#if @root.editingSkills}}bh-editing{{/if}} {{#if trained}}bh-trained{{/if}}">{{#if @root.editingSkills}}<input type="checkbox" name="system.trained.{{id}}" aria-label="{{localize 'BOOTHILL.Text.aed0c93b'}} {{label}}" {{checked trained}}>{{/if}}<button type="button" class="bh-roll-name" data-action="check" data-group="skills" data-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}} title="{{localize 'BOOTHILL.Text.378250d5'}} {{label}} {{localize 'BOOTHILL.Text.82c76c8c'}}"><i class="fas fa-dice-d20" aria-hidden="true"></i><span>{{label}}</span></button><input aria-label="{{localize 'BOOTHILL.Text.3663421a'}} {{label}}" type="number" min="0" step="1" name="system.skills.{{id}}" value="{{value}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if @root.editingSkills}}<button type="button" class="bh-generate-skill" data-action="generateSkill" data-id="{{id}}" aria-label="{{localize 'BOOTHILL.Text.7ebef51d'}} {{label}} {{localize 'BOOTHILL.Text.fd44a85d'}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-dice" aria-hidden="true"></i></button>{{/if}}</div>{{/each}}
      {{#unless hasWork}}<p class="bh-empty">{{localize 'BOOTHILL.Text.d48deb9a'}}</p>{{/unless}}
    </section>
    </div>
  </div>
</section>
