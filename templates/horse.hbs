<section class="bh-page bh-horse-page">
<header class="bh-header"><button type="button" class="bh-portrait" data-action="showTokenArtwork" draggable="true" data-horse-drag aria-label="Ver imagem do token do cavalo"><img src="{{tokenImage}}" alt="Token de {{actor.name}}"></button><div class="bh-identity"><div class="bh-name-line"><label class="bh-name">Nome do cavalo<input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><span class="bh-wordmark">BOOT HILL<small>3ª edição</small></span></div></div></header>
<div class="bh-section-strip">Ficha de cavalo <span>Boot Hill</span></div>
<div class="bh-body bh-horse-grid">
<section class="bh-section bh-horse-attribute-panel" aria-label="Atributos do cavalo"><h2>Atributos</h2><div class="bh-horse-attributes">{{#each attributes}}<div><button type="button" class="bh-roll-name" data-action="check" data-group="attributes" data-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-{{icon}}" aria-hidden="true"></i>{{label}}</button><input type="number" min="0" step="1" name="system.attributes.{{id}}" value="{{value}}" aria-label="Nível de {{label}}" {{#unless @root.editable}}disabled{{/unless}}></div>{{/each}}</div>
</section>
<section class="bh-section bh-horse-health" aria-label="Saúde do cavalo"><h2>Saúde <span>Leves / Sérios</span></h2>
<div class="bh-horse-map"><img src="systems/boothill/assets/horse.png" alt="Silhueta de cavalo de perfil, cabeça à esquerda e cauda à direita">{{#each locations}}<div class="bh-horse-location bh-horse-{{id}}"><span>{{label}}</span><div><label>L<input type="number" min="0" step="1" name="system.health.locations.{{id}}.light" value="{{light}}" aria-label="Ferimentos leves: {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label><label>S<input type="number" min="0" step="1" name="system.health.locations.{{id}}.serious" value="{{serious}}" aria-label="Ferimentos sérios: {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label></div></div>{{/each}}</div>
<div class="bh-health-points"><label>Pontos de ferimento<input type="number" min="0" step="1" name="system.health.points" value="{{actor.system.health.points}}" {{#unless editable}}disabled{{/unless}}></label><label>Pontos temporários<input type="number" min="0" step="1" name="system.health.temporary" value="{{actor.system.health.temporary}}" {{#unless editable}}disabled{{/unless}}></label></div><div class="bh-health-total {{#if health.unconscious}}bh-danger{{/if}}"><strong>{{health.total}} / {{actor.system.attributes.strength}}</strong><span>Ferimentos / Força {{#if health.unconscious}}· Desmaiado{{/if}}</span></div><button type="button" class="bh-mortal-toggle" data-action="toggleMortal" aria-pressed="{{actor.system.health.mortal}}" {{#unless editable}}disabled{{/unless}}>Ferimento mortal <span>{{#if actor.system.health.mortal}}Sim{{else}}Não{{/if}}</span></button>
</section>
<section class="bh-section bh-inventory"><h2>Inventário</h2><table><thead><tr><th>Qtd.</th><th>Item</th><th>Peso</th></tr></thead><tbody>{{#each gear}}<tr><td>{{#if weapon}}<img class="bh-weapon-thumb" src="{{img}}" alt="{{name}}">{{else}}<input type="number" min="1" step="1" value="{{quantity}}" data-inventory-id="{{id}}" data-field="quantity" aria-label="Quantidade de {{name}}">{{/if}}</td><td>{{#if weapon}}<button type="button" class="bh-roll-name" data-action="openWeapon" data-id="{{id}}">{{name}}</button>{{else}}{{name}} <button type="button" class="bh-remove-gear" data-action="removeGear" data-id="{{id}}" aria-label="Remover {{name}}">×</button>{{/if}}</td><td><input type="number" min="0" step="0.01" value="{{weight}}" data-inventory-id="{{id}}" data-field="weight" data-weapon="{{weapon}}" aria-label="Peso de {{name}} em kg"></td></tr>{{/each}}</tbody></table><p class="bh-load">Carga <strong>{{totalWeight}} kg</strong> / <label>Limite (kg)<input type="number" min="0" step="0.01" name="system.carryCapacity" value="{{actor.system.carryCapacity}}"></label></p><div class="bh-add-gear"><input type="number" min="1" step="1" value="1" data-gear-quantity aria-label="Quantidade do item"><input data-gear-name placeholder="Nome do item" aria-label="Nome do item"><input type="number" min="0" step="0.01" value="0" data-gear-weight aria-label="Peso do item em kg"><button type="button" data-action="addGear" {{#unless editable}}disabled{{/unless}} aria-label="Adicionar item" title="Adicionar item"><i class="fas fa-plus" aria-hidden="true"></i></button></div></section>
<section class="bh-section bh-horse-skills" aria-label="Perícias do cavalo"><h2><span class="bh-work-title">Perícias do cavalo <button type="button" class="bh-skill-settings {{#if editingSkills}}active{{/if}}" data-action="toggleSkills" aria-label="{{#if editingSkills}}Mostrar apenas perícias treinadas{{else}}Configurar perícias treinadas{{/if}}" aria-pressed="{{editingSkills}}" {{#unless editable}}disabled{{/unless}}><i class="fas fa-gear" aria-hidden="true"></i></button></span></h2>{{#unless hasHorseSkills}}{{#unless editingSkills}}<p class="bh-empty">Use a engrenagem para selecionar as perícias conhecidas.</p>{{/unless}}{{/unless}}{{#each skills}}<div class="bh-horse-skill {{#if @root.editingSkills}}bh-horse-editing{{/if}}">{{#if @root.editingSkills}}<input type="checkbox" name="system.trained.{{id}}" aria-label="Treinado em {{label}}" {{checked trained}} {{#unless @root.editable}}disabled{{/unless}}>{{/if}}<button type="button" class="bh-roll-name" data-action="check" data-group="skills" data-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-dice-d20" aria-hidden="true"></i>{{label}}</button><input type="number" name="system.skills.{{id}}" value="{{value}}" min="0" step="1" aria-label="Nível de {{label}}" {{#unless @root.editable}}disabled{{/unless}}></div>{{/each}}
<h3>Truques</h3>{{#each tricks}}<div class="bh-horse-skill bh-horse-trick {{#if @root.editingSkills}}bh-horse-editing{{/if}}"><button type="button" class="bh-roll-name" data-action="check" data-group="tricks" data-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}}><i class="fas fa-dice-d20" aria-hidden="true"></i><span>{{name}}</span></button><input type="number" value="{{level}}" min="0" step="1" data-trick-id="{{id}}" aria-label="Nível de {{name}}" {{#unless @root.editable}}disabled{{/unless}}>{{#if @root.editingSkills}}<button type="button" class="bh-remove-gear" data-action="removeTrick" data-id="{{id}}" aria-label="Remover truque {{name}}" {{#unless @root.editable}}disabled{{/unless}}>×</button>{{/if}}</div>{{/each}}{{#if editingSkills}}<div class="bh-add-trick"><input data-trick-name placeholder="Nome do truque" aria-label="Nome do truque" {{#unless editable}}disabled{{/unless}}><button type="button" data-action="addTrick" aria-label="Adicionar truque" {{#unless editable}}disabled{{/unless}}>+</button></div>{{/if}}
</section></div></section>