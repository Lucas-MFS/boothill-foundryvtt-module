<section class="bh-page"><header class="bh-header bh-item-header"><img class="bh-item-image" src="{{item.img}}" alt="{{localize 'BOOTHILL.Text.7dbd591c'}} {{item.name}}" data-edit="img" {{#if editable}}data-action="editImage" role="button" aria-label="{{localize 'BOOTHILL.Text.2cf76651'}}"{{/if}}><div class="bh-identity"><label class="bh-name">{{localize 'BOOTHILL.Text.b67ab03d'}}<input name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}></label></div></header><div class="bh-body bh-compact-weapon"><fieldset class="bh-weapon-fields bh-ammunition-fields" {{#unless editable}}disabled{{/unless}}><label>{{localize 'BOOTHILL.Text.4c2ca24d'}}<input type="number" name="system.quantity" min="0" step="1" value="{{system.quantity}}"></label><label>{{localize 'BOOTHILL.Text.3305c389'}}<input name="system.caliber" value="{{system.caliber}}"></label><label>{{localize 'BOOTHILL.Text.cab36256'}}<input type="number" name="system.weight" min="0" step="0.001" value="{{system.weight}}"></label><label class="bh-ammunition-notes">{{localize 'BOOTHILL.Text.b610a7fb'}}<textarea name="system.notes" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label></fieldset></div></section>
