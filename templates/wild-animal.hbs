<section class="bh-page bh-horse-page">
<header class="bh-header"><button type="button" class="bh-portrait" data-action="showTokenArtwork" draggable="true" data-horse-drag aria-label="Ver imagem do token do animal"><img src="{{tokenImage}}" alt="Token de {{actor.name}}"></button><div class="bh-identity"><div class="bh-name-line"><label class="bh-name">Nome do animal<input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label><span class="bh-wordmark">BOOT HILL<small>3ª edição</small></span></div></div></header>
<div class="bh-section-strip">Ficha de animal selvagem <span>Boot Hill</span></div>
<div class="bh-body bh-horse-grid">
<section class="bh-section bh-horse-attribute-panel" aria-label="Atributos do animal"><h2 class="bh-animal-heading"><span>Atributos</span><button type="button" class="bh-animal-attack-button" data-action="attackAnimal" title="Atacar · Shift+clique para ajustar" {{#unless editable}}disabled{{/unless}}><i class="fas fa-paw" aria-hidden="true"></i> Atacar</button></h2><div class="bh-horse-attributes"><div><label>Força<input type="number" min="0" step="1" name="system.attributes.strength" value="{{actor.system.attributes.strength}}" {{#unless editable}}disabled{{/unless}}></label></div><div><label>Ataque<input type="number" step="1" name="system.animal.attack" value="{{animal.attack}}" {{#unless editable}}disabled{{/unless}}></label></div><div><label>Ferimentos adicionais<input type="number" step="1" name="system.animal.severity" value="{{animal.severity}}" {{#unless editable}}disabled{{/unless}}></label></div><div><label>Defesa de ferimentos<input type="number" step="1" name="system.animal.defense" value="{{animal.defense}}" {{#unless editable}}disabled{{/unless}}></label></div></div>
</section>
<section class="bh-section bh-horse-health" aria-label="Saúde do animal"><h2>Saúde <span>Leves / Sérios</span></h2>
<div class="bh-horse-map bh-wild-map"><img src="systems/boothill/assets/bear.png" alt="Silhueta de animal de perfil, cabeça à esquerda">{{#each locations}}<div class="bh-horse-location bh-horse-{{id}}"><span>{{label}}</span><div><label>L<input type="number" min="0" step="1" name="system.health.locations.{{id}}.light" value="{{light}}" aria-label="Ferimentos leves: {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label><label>S<input type="number" min="0" step="1" name="system.health.locations.{{id}}.serious" value="{{serious}}" aria-label="Ferimentos sérios: {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label></div></div>{{/each}}</div>
<div class="bh-health-points"><label>Pontos de ferimento<input type="number" name="system.health.points" value="{{actor.system.health.points}}" min="0" step="1" aria-label="Pontos de ferimento" {{#unless editable}}disabled{{/unless}}></label><label>Pontos temporários<input type="number" min="0" step="1" name="system.health.temporary" value="{{actor.system.health.temporary}}" {{#unless editable}}disabled{{/unless}}></label></div><div class="bh-health-total {{#if health.unconscious}}bh-danger{{/if}}"><strong>{{health.total}} / {{actor.system.attributes.strength}}</strong><span>Ferimentos / Força {{#if health.unconscious}}· Desmaiado{{/if}}</span></div><button type="button" class="bh-mortal-toggle" data-action="toggleMortal" aria-pressed="{{actor.system.health.mortal}}" {{#unless editable}}disabled{{/unless}}>Ferimento mortal <span>{{#if actor.system.health.mortal}}Sim{{else}}Não{{/if}}</span></button>
</section>
</div></section>
